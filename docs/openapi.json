  "components": {
    "schemas": {
      "Body_login_auth_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_login_auth_token_post"
      },
      "CatalogModel": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug"
          },
          "version": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Version"
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description"
          },
          "category": {
            "type": "string",
            "enum": [
              "classical_ml",
              "deep_learning",
              "hybrid"
            ],
            "title": "Category"
          },
          "signals": {
            "items": {
              "type": "string",
              "enum": [
                "eeg",
                "ecg",
                "eog",
                "imu",
                "video_features"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Signals"
          },
          "tags": {
            "items": {
              "type": "string",
              "maxLength": 40,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 15,
            "title": "Tags"
          },
          "requirements": {
            "$ref": "#/components/schemas/Requirements"
          },
          "evaluation": {
            "$ref": "#/components/schemas/Evaluation"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "slug",
          "version",
          "description",
          "category",
          "signals",
          "requirements",
          "evaluation"
        ],
        "title": "CatalogModel"
      },
      "DeviceProfile": {
        "properties": {
          "signal": {
            "type": "string",
            "enum": [
              "eeg",
              "ecg",
              "eog",
              "imu",
              "video_features"
            ],
            "title": "Signal"
          },
          "memory_budget_mb": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.001,
            "title": "Memory Budget Mb"
          },
          "max_latency_ms": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.001,
            "title": "Max Latency Ms"
          },
          "reference_device": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reference Device"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "signal",
          "memory_budget_mb",
          "max_latency_ms",
          "reference_device"
        ],
        "title": "DeviceProfile"
      },
      "Evaluation": {
        "properties": {
          "f1": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "F1"
          },
          "dataset": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Dataset"
          },
          "protocol": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Protocol"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "f1",
          "dataset",
          "protocol"
        ],
        "title": "Evaluation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Interaction": {
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$",
            "title": "Model Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "view",
              "save",
              "select",
              "rating"
            ],
            "title": "Type"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
